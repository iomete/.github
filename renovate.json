{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "docker": {
    "pinDigests": true
  },
  "labels": ["dependencies", "renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the gitleaks image pinned in the shared PR checks workflow",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "(?<depName>ghcr\\.io/gitleaks/gitleaks):(?<currentValue>[^\\s@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
